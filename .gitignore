# .gitignore

# Ignore Python cache files
__pycache__/
*.py[cod]
*$py.class

# Ignore virtual environment folders (adjust name if needed)
venv/
env/
.venv/
.env/

# Ignore IDE/Editor specific files
.idea/
.vscode/
*.swp
*~

# Ignore generated output folders
logs/
results/
saved_models/

# Ignore OS-specific files (optional)
.DS_Store
Thumbs.db

# Ignore dependency folders (if not using virtual environments properly)
# node_modules/ # Example for Node.js

# Ignore sensitive files
# secrets.yaml
# Alpaca / AlphaVantage / Finnhub API keys — never commit this
.env
# Downloaded price data — regenerate on demand
data/cache/
# FA discovery raw archive + frozen rankings — data lives out of git
fa/archive/
fa/artifacts/
# v3 1m underlying archive (5+ GB of parquet partitions) — never in git
v3/data/
# v3-pool retrain outputs (NN_META_POOL=v3 suffixed dirs) — bulky and
# regenerable; on a winning verdict, force-add the keepers (spec, ensemble
# config, final models) exactly like v2 did
nn_meta/artifacts_v3/
nn_meta/runs_v3/
nn_meta/reports_v3/
nn_meta/model_final_v3/
