[Unit]
# The box is the sole holder of entitlement-rolled market data (see
# scripts/backup_caches.sh). Weekly one-way push to gs://healys-backtester.
Description=HealysBacktester irreplaceable-cache backup to GCS
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=healy
Group=healy
WorkingDirectory=/home/healy/Coding/HealysBacktester
ExecStart=/home/healy/Coding/HealysBacktester/scripts/backup_caches.sh
# Incremental runs are minutes; the first full ~10 GB push can take longer.
TimeoutStartSec=4h
StandardOutput=append:/home/healy/Coding/HealysBacktester/logs/cache_backup.log
StandardError=append:/home/healy/Coding/HealysBacktester/logs/cache_backup.log
