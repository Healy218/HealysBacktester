[Unit]
Description=V6 after-close continual research and bounded overnight retries

[Timer]
OnCalendar=Mon..Fri *-*-* 16:45:00 America/New_York
OnCalendar=Mon..Sat *-*-* 00..07:00/15:00 America/Chicago
AccuracySec=1min
Persistent=true
Unit=healys-v6-continual.service

[Install]
WantedBy=timers.target
