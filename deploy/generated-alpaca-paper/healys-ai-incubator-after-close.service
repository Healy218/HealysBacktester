[Unit]
Description=Healy AI incubator after-close read-only campaign
Requires=healys-ai-incubator-stage-v5.service
After=healys-ai-incubator-stage-v5.service

[Service]
Type=oneshot
WorkingDirectory=/home/healy/Coding/HealysBacktester
ExecStart=/home/healy/Coding/HealysBacktester/venv/bin/python /home/healy/Coding/HealysBacktester/scripts/ai_incubator_after_close.py --bundle-root /home/healy/Coding/HealysBacktester/incubator/artifacts/active --v6-index /home/healy/Coding/HealysV6/nn_meta/live/v6_alpaca_paper/data-index.json --v6-candidates-root /home/healy/Coding/HealysV6/nn_meta/live/v6_alpaca_paper/passes --v6-model-config /home/healy/Coding/HealysBacktester/deploy/v6/releases/v6-cash-repair-20260913/model/ensemble_config.json --v5-pass-root /home/healy/Coding/HealysBacktester/incubator/artifacts/v5-passes --v5-model-config /home/healy/Coding/HealysBacktester/nn_meta/model_final_v5/ensemble_config.json --feature-root /home/healy/Coding/HealysBacktester/incubator/artifacts/daily --output-dir /home/healy/Coding/HealysBacktester/incubator/runs/after-close --memory-bytes 4294967296 --artifact-seconds 300 --allow-execution
Environment=PYTHONDONTWRITEBYTECODE=1
TimeoutStartSec=2h
UMask=0077
MemoryMax=5G
CPUQuota=200%
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/healy/Coding/HealysBacktester/incubator/artifacts/daily /home/healy/Coding/HealysBacktester/incubator/runs/after-close

[Install]
WantedBy=default.target
