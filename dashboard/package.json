{
  "name": "healylabs-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --exclude '**/firestore.rules.test.ts'",
    "test:rules": "firebase emulators:exec --project demo-healylabs --only firestore 'vitest run tests/firestore.rules.test.ts'",
    "test:browser": "playwright test",
    "ios:add": "cap add ios",
    "ios:sync": "npm run build && cap sync ios",
    "check:deploy": "node scripts/check-deploy.mjs",
    "test:auth-browser": "firebase emulators:exec --project demo-healylabs --only auth,firestore \"playwright test --config playwright.auth.config.ts\""
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "firebase": "^12.19.0",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase-admin": "^14.4.0",
    "firebase-tools": "^15.30.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
