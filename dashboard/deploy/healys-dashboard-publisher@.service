[Unit]
Description=HealyLabs dashboard summary publisher (%i)
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
# Use a separate checkout. Configure these values through systemctl edit.
EnvironmentFile=%h/.config/healylabs-dashboard/%i.env
ExecStart=/usr/bin/env ${DASHBOARD_PYTHON} ${DASHBOARD_ROOT}/publisher/publish.py --publish
Nice=15
CPUQuota=25%
MemoryMax=512M
TimeoutStartSec=50
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/healylabs-dashboard
