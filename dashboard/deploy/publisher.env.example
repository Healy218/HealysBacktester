# Set separately on each host; chmod 600. Do not commit the populated file.
DASHBOARD_ROOT=/absolute/path/to/isolated-checkout/dashboard
DASHBOARD_PYTHON=/absolute/path/to/venv/bin/python
SOURCE=server
SOURCE_ROOT=/absolute/path/to/HealysBacktester
FIREBASE_PROJECT=your-separate-spark-project
PUBLISHER_STATE=/home/youruser/.local/state/healylabs-dashboard
GOOGLE_APPLICATION_CREDENTIALS=/home/youruser/.config/healylabs-dashboard/publisher.json
# Home publisher uses SOURCE=home and SOURCE_ROOT=.../HealysAutomation.
# Pin the actual campaign receipt; do not discover a campaign by newest folder.
# PROGRESS_RECEIPT=/absolute/path/to/HealysBacktester/logs/v6-progress/CAMPAIGN/latest.json
