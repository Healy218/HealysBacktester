+def test_evaluation_failure_visible_before_any_finalization_log(tmp_path, monkeypatch):
+    base = fixture(tmp_path, monkeypatch, 'failed', 'evaluate')
+    write(base / 'runs/pipeline/status.json', dict(campaign='current', status='failed', stage='training',
+                                                  error='evaluation cash ledger rejected an entry'))
+    r, status = training.live(tmp_path, 'current')
+    assert r['status'] == 'Failed'
+    assert status['activity'] == 'Pipeline failed during training'
+    assert r['notes'][0] == 'evaluation cash ledger rejected an entry'
+    assert not (base / 'runs/continuation/finalize.log').exists()
+
+
+def test_pipeline_campaign_mismatch_refuses_dashboard_report(tmp_path, monkeypatch):
+    base = fixture(tmp_path, monkeypatch)
+    write(base / 'runs/pipeline/status.json', dict(campaign='other', status='running', stage='execution'))
+    assert training.collect_training(tmp_path, 'current')['status'] == 'Unavailable'
+
+
+def test_pipeline_validation_activity_is_displayed(tmp_path, monkeypatch):
+    base = fixture(tmp_path, monkeypatch)
+    write(base / 'runs/pipeline/status.json', dict(campaign='current', status='running', stage='execution'))
+    r, status = training.live(tmp_path, 'current')
+    assert r['status'] == 'Validating'
+    assert status['activity'] == 'Training complete; execution running'
+    assert status['stage'] == 'execution'
+
+
